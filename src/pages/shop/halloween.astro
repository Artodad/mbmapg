---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ZeffyCheckout from '../../components/ZeffyCheckout.astro';
import ZeffyTipNotice from '../../components/ZeffyTipNotice.astro';
import { asset, withBase } from '../../lib/site';
import {
  carnivalNonprofitSentence,
  currentWristbandTierNow,
  sponsorships,
  sponsorshipZeffyBuyHref,
  sponsorshipZeffyFormLink,
  wristbandTiers,
  wristbandZeffyBuyHref,
  wristbandZeffyFormLink,
} from '../../lib/halloween-shop';

const currentTier = currentWristbandTierNow();
---

<Base
  title="Halloween Carnival"
  description="Halloween Carnival wristbands and sponsorships for the MBMA Parents Group."
>
  <div class="halloween-store">
    <div class="flyer-ghosts" aria-hidden="true">
      <svg class="flyer-ghost flyer-ghost-a" viewBox="0 0 64 80" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="#fffdf8"
          stroke="#c4b0e0"
          stroke-width="2"
          d="M32 8c-14 0-22 12-22 26v28c4-6 8 6 12 0s8-6 12 0 8 6 12 0 8-6 8 0V34C54 20 46 8 32 8z"
        ></path>
        <ellipse cx="24" cy="34" rx="3.2" ry="4" fill="#4a3520"></ellipse>
        <ellipse cx="40" cy="34" rx="3.2" ry="4" fill="#4a3520"></ellipse>
        <path d="M24 46c3.2 5 12.8 5 16 0" fill="none" stroke="#4a3520" stroke-width="2" stroke-linecap="round"></path>
        <ellipse cx="18" cy="42" rx="3" ry="2" fill="#f6c3cb"></ellipse>
        <ellipse cx="46" cy="42" rx="3" ry="2" fill="#f6c3cb"></ellipse>
      </svg>
      <svg class="flyer-ghost flyer-ghost-b" viewBox="0 0 64 80" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="#fffdf8"
          stroke="#c4b0e0"
          stroke-width="2"
          d="M32 10c-13 0-20 11-20 24v26c3.5-5 7.5 5 11 0s7.5-5 11 0 7.5 5 11 0 7-5 7 0V34C53 21 45 10 32 10z"
        ></path>
        <ellipse cx="24" cy="34" rx="3.2" ry="4" fill="#4a3520"></ellipse>
        <path d="M36 32c3.4 0 6 2 6 4.2" fill="none" stroke="#4a3520" stroke-width="2" stroke-linecap="round"></path>
        <path d="M22 46c4 6 16 6 20 0" fill="none" stroke="#4a3520" stroke-width="2" stroke-linecap="round"></path>
        <ellipse cx="18" cy="42" rx="3" ry="2" fill="#f6c3cb"></ellipse>
        <ellipse cx="46" cy="42" rx="3" ry="2" fill="#f6c3cb"></ellipse>
      </svg>
    </div>
    <PageHero
      title="Halloween Carnival"
      eyebrow="School carnival"
      lede="Wristbands and sponsorships for the MBMA Halloween Carnival."
    >
      <p class="carnival-banner">Beware: candy and face paint</p>
    </PageHero>
    <main id="main">
      <div class="wrap">
        <ZeffyTipNotice />
        <figure class="halloween-festive">
          <img
            src={asset('images/gallery/halloween-pumpkins.jpg')}
            alt="Decorated pumpkins at an MBMA Halloween contest"
            width="1200"
            height="800"
          />
        </figure>

        <section aria-labelledby="wristbands-heading">
          <h2 id="wristbands-heading" class="section-title">Wristbands</h2>
          <figure class="wristband-flyer">
            <img
              src={asset('images/shop/halloween-carnival-wristbands-flyer.jpg')}
              alt="Halloween Carnival Wristbands flyer"
              width="735"
              height="1600"
            />
          </figure>
          <div class="wristband-copy">
            <p>Pre-Sale Halloween Carnival Wristbands</p>
            <p>Every child must have a wristband to enter the carnival.  Adults and Children under 2 are free. Admission wristbands allow unlimited access to carnival games and activities (Children without admission wristbands will not be allowed entry to the carnival following the parade)</p>
            <p>You can purchase for more than one student/child - Just add to the cart with the first student's information, then go back to the shop and select the wristband again adding to the cart with the second student's information.  Repeat steps for as many wristbands needed.  Checkout when all student wristband information is in the cart.</p>
            <p>Early Bird purchase will end after Oct 23rd, and will then go to pricing @ $50.</p>
            <p>All pre-order wristbands will be put into bags handed out to students the day of the carnival.</p>
            <p>If you are purchasing for MBMA Alumni or non-MBMA persons, please pick up their ticket at the ticket booth on the day of carnival.</p>
          </div>
          <div class="wristband-layout">
            <img
              class="wristband-art"
              src={asset('images/shop/halloween-wristband.jpg')}
              alt="Orange treat bag and orange wristband"
              width="1080"
              height="1080"
            />
            <div class="wristband-details">
              <div class="product-grid">
                {
                  wristbandTiers.map((tier) => {
                    const appliesNow = tier.id === currentTier;
                    return (
                      <article
                        class:list={['product', { 'is-current': appliesNow }]}
                        data-wristband-tier={tier.id}
                      >
                        <h2>Halloween Carnival Wristband</h2>
                        <p class="price">{tier.price}</p>
                        <p class="muted">{tier.window}</p>
                        {
                          appliesNow ? (
                            <p class="tier-now">This price applies now</p>
                          ) : null
                        }
                      </article>
                    );
                  })
                }
              </div>
              <p class="muted wristband-after" data-wristband-after hidden={currentTier !== null}>
                These listed prices apply through October 29, 2026.
              </p>
              <p class="product-actions">
                <a class="btn btn-peach" href={wristbandZeffyBuyHref} zeffy-form-link={wristbandZeffyFormLink}>
                  Buy a wristband
                </a>
              </p>
            </div>
          </div>
        </section>

        <section aria-labelledby="sponsorships-heading">
          <h2 id="sponsorships-heading" class="section-title">Sponsorships</h2>
          <p class="sponsor-intro">{carnivalNonprofitSentence}</p>
          <div class="product-grid">
            {
              sponsorships.map((item) => (
                <article class="product">
                  {item.name === 'Plentiful Pumpkins' ? (
                    <svg class="sponsor-art" viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect width="96" height="96" rx="18" fill="#F9DCC4"></rect>
                      <path d="M48 16c1.2 8 .2 13-.2 16" stroke="#5f8f3c" stroke-width="3.2" fill="none" stroke-linecap="round"></path>
                      <path d="M49 20c8-1 12 4 9 8-4-1-7 0-9 2" fill="#6ea34a"></path>
                      <ellipse cx="48" cy="56" rx="26" ry="22" fill="#e07a2f"></ellipse>
                      <ellipse cx="36" cy="56" rx="10" ry="21" fill="#f1923c"></ellipse>
                      <ellipse cx="60" cy="56" rx="10" ry="21" fill="#d06820"></ellipse>
                      <path d="M48 36v38" stroke="#c45e1c" stroke-width="1.6" opacity="0.55"></path>
                      <ellipse cx="38" cy="52" rx="3.3" ry="3.8" fill="#4A3520"></ellipse>
                      <ellipse cx="58" cy="52" rx="3.3" ry="3.8" fill="#4A3520"></ellipse>
                      <ellipse cx="39.1" cy="50.8" rx="1.1" ry="1.2" fill="#fffdf8"></ellipse>
                      <ellipse cx="59.1" cy="50.8" rx="1.1" ry="1.2" fill="#fffdf8"></ellipse>
                      <path d="M38 62c4 5 16 5 20 0" fill="none" stroke="#4A3520" stroke-width="2.2" stroke-linecap="round"></path>
                      <ellipse cx="30" cy="60" rx="3" ry="1.8" fill="#f6b7c2"></ellipse>
                      <ellipse cx="66" cy="60" rx="3" ry="1.8" fill="#f6b7c2"></ellipse>
                    </svg>
                  ) : item.name === 'Giving Goblins' ? (
                    <svg class="sponsor-art" viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect width="96" height="96" rx="18" fill="#FEF5ED"></rect>
                      <path d="M22 48c-9-2-14-14-6-18 5 7 10 12 14 14" fill="#7dba6a"></path>
                      <path d="M74 48c9-2 14-14 6-18-5 7-10 12-14 14" fill="#7dba6a"></path>
                      <ellipse cx="22" cy="42" rx="3.4" ry="4.2" fill="#f3c2cf"></ellipse>
                      <ellipse cx="74" cy="42" rx="3.4" ry="4.2" fill="#f3c2cf"></ellipse>
                      <ellipse cx="48" cy="54" rx="24" ry="22" fill="#8fc97a"></ellipse>
                      <path d="M36 34c2-10 9-14 13-7 3-9 13-6 15 3 5-2 9 3 6 7" fill="#6eae58"></path>
                      <ellipse cx="38" cy="52" rx="6" ry="6.5" fill="#fffdf8"></ellipse>
                      <ellipse cx="58" cy="52" rx="6" ry="6.5" fill="#fffdf8"></ellipse>
                      <ellipse cx="39.2" cy="53" rx="2.7" ry="3" fill="#3d5c34"></ellipse>
                      <ellipse cx="59.2" cy="53" rx="2.7" ry="3" fill="#3d5c34"></ellipse>
                      <ellipse cx="40.2" cy="51.8" rx="1" ry="1.1" fill="#fffdf8"></ellipse>
                      <ellipse cx="60.2" cy="51.8" rx="1" ry="1.1" fill="#fffdf8"></ellipse>
                      <ellipse cx="48" cy="60" rx="2.2" ry="1.6" fill="#6aa85a"></ellipse>
                      <path d="M38 66c3.5 5 16.5 5 20 0" fill="none" stroke="#3d6b32" stroke-width="2.2" stroke-linecap="round"></path>
                      <ellipse cx="30" cy="62" rx="3" ry="1.8" fill="#f6b7c2"></ellipse>
                      <ellipse cx="66" cy="62" rx="3" ry="1.8" fill="#f6b7c2"></ellipse>
                    </svg>
                  ) : item.name === 'Philanthropic Phantoms' ? (
                    <svg class="sponsor-art" viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect width="96" height="96" rx="18" fill="#F9DCC4"></rect>
                      <path
                        fill="#fffdf8"
                        stroke="#d4c2ea"
                        stroke-width="2"
                        d="M28 48c0-16 9-28 20-28s20 12 20 28v30c-4-8-8 6-13 0s-8-8-14 0-9 8-13 0V48z"
                      ></path>
                      <ellipse cx="40" cy="50" rx="3.1" ry="3.8" fill="#4A3520"></ellipse>
                      <ellipse cx="56" cy="50" rx="3.1" ry="3.8" fill="#4A3520"></ellipse>
                      <ellipse cx="41" cy="48.8" rx="1.1" ry="1.2" fill="#fffdf8"></ellipse>
                      <ellipse cx="57" cy="48.8" rx="1.1" ry="1.2" fill="#fffdf8"></ellipse>
                      <path d="M40 60c3.4 4.5 12.6 4.5 16 0" fill="none" stroke="#4A3520" stroke-width="2.2" stroke-linecap="round"></path>
                      <ellipse cx="33" cy="58" rx="2.8" ry="1.7" fill="#f6c3cb"></ellipse>
                      <ellipse cx="63" cy="58" rx="2.8" ry="1.7" fill="#f6c3cb"></ellipse>
                    </svg>
                  ) : item.name === 'Magnanimous Mummies' ? (
                    <svg class="sponsor-art" viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect width="96" height="96" rx="18" fill="#FEF5ED"></rect>
                      <ellipse cx="48" cy="54" rx="20" ry="26" fill="#f7f1e6"></ellipse>
                      <path d="M30 38c8-8 28-8 36 0" fill="none" stroke="#e6d3b4" stroke-width="5" stroke-linecap="round"></path>
                      <path d="M29 50h38" stroke="#eadcc4" stroke-width="5" stroke-linecap="round"></path>
                      <path d="M28 66h40" stroke="#eadcc4" stroke-width="5" stroke-linecap="round"></path>
                      <path d="M33 76h26" stroke="#eadcc4" stroke-width="5" stroke-linecap="round"></path>
                      <path d="M64 74c8 1 12 7 7 10" fill="none" stroke="#f7f1e6" stroke-width="5" stroke-linecap="round"></path>
                      <rect x="34" y="46" width="28" height="16" rx="8" fill="#F9DCC4"></rect>
                      <ellipse cx="42" cy="53" rx="2.6" ry="3" fill="#4A3520"></ellipse>
                      <ellipse cx="54" cy="53" rx="2.6" ry="3" fill="#4A3520"></ellipse>
                      <ellipse cx="42.9" cy="52" rx="0.9" ry="1" fill="#fffdf8"></ellipse>
                      <ellipse cx="54.9" cy="52" rx="0.9" ry="1" fill="#fffdf8"></ellipse>
                      <path d="M43 58c2 2.4 8 2.4 10 0" fill="none" stroke="#4A3520" stroke-width="1.8" stroke-linecap="round"></path>
                      <ellipse cx="37" cy="56" rx="2" ry="1.2" fill="#f6c3cb"></ellipse>
                      <ellipse cx="59" cy="56" rx="2" ry="1.2" fill="#f6c3cb"></ellipse>
                    </svg>
                  ) : null}
                  <h2>{item.name}</h2>
                  <p class="price">{item.price}</p>
                  {item.blurb ? <p class="sponsor-blurb">{item.blurb}</p> : null}
                </article>
              ))
            }
          </div>
          <p class="product-actions">
            <a
              class="btn btn-peach"
              href={sponsorshipZeffyBuyHref}
              zeffy-form-link={sponsorshipZeffyFormLink}
            >
              Buy a sponsorship
            </a>
          </p>
        </section>

        <p class="halloween-back">
          <a href={withBase('shop')}>Back to the shop</a>
        </p>
      </div>
    </main>
  </div>
  <ZeffyCheckout />
</Base>

<script>
  import { currentWristbandTierNow } from '../../lib/halloween-shop';

  const tier = currentWristbandTierNow();
  const appliesNowLabel = 'This price applies now';
  document.querySelectorAll('[data-wristband-tier]').forEach((el) => {
    const appliesNow = el.getAttribute('data-wristband-tier') === tier;
    el.classList.toggle('is-current', appliesNow);
    const flag = el.querySelector('.tier-now');
    if (appliesNow) {
      if (!(flag instanceof HTMLElement)) {
        const note = document.createElement('p');
        note.className = 'tier-now';
        note.textContent = appliesNowLabel;
        const scope = [...el.attributes].find((attr) => attr.name.startsWith('data-astro-cid'));
        if (scope) note.setAttribute(scope.name, scope.value);
        el.append(note);
      }
      return;
    }
    flag?.remove();
  });
  const after = document.querySelector('[data-wristband-after]');
  if (after instanceof HTMLElement) after.hidden = tier !== null;
</script>

<style>
  .halloween-store {
    position: relative;
  }

  .flyer-ghosts {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto 0;
    height: 7rem;
    pointer-events: none;
  }

  .flyer-ghost {
    position: absolute;
    width: 4.4rem;
    height: auto;
    animation: flyer-float 5.2s ease-in-out infinite;
  }

  .flyer-ghost-a {
    left: max(0.6rem, calc(50% - 24rem));
    top: 0.85rem;
  }

  .flyer-ghost-b {
    right: max(0.6rem, calc(50% - 22rem));
    top: 1.35rem;
    width: 3.7rem;
    animation-duration: 6.4s;
    animation-delay: -2s;
  }

  .carnival-banner {
    display: inline-block;
    max-width: 100%;
    margin: 0.85rem 0 0;
    padding: 0.45rem 0.85rem;
    background: var(--cream);
    color: #6b4c8a;
    border: 3px dashed #e07a2f;
    border-radius: 999px;
    font-family: var(--heading);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.35;
    text-align: center;
  }

  .halloween-store :global(.page-hero) {
    background: linear-gradient(180deg, #efe6f8 0%, var(--cream-deep) 100%);
    padding-top: 6.6rem;
  }

  .halloween-store :global(.page-hero .wrap) {
    min-width: 0;
  }

  .halloween-store :global(.page-hero .eyebrow) {
    color: #6b4c8a;
  }

  .halloween-festive {
    margin: 0 0 1.5rem;
  }

  .halloween-festive img {
    display: block;
    width: 100%;
    max-height: 180px;
    object-fit: cover;
    object-position: center 42%;
    background: var(--cream-deep);
    border: 1px solid var(--rule);
    border-radius: var(--radius-img);
  }

  .halloween-store .product-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
  }

  .halloween-store .product {
    min-width: 0;
  }

  .halloween-store .product h2 {
    overflow-wrap: break-word;
  }

  .wristband-layout,
  .wristband-details {
    min-width: 0;
  }

  .product-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 1rem 0 0;
  }

  .product-actions .btn {
    max-width: 100%;
    text-align: center;
  }

  .wristband-flyer {
    margin: 0.15rem auto 1rem;
    width: 100%;
    max-width: 480px;
  }

  .wristband-flyer img {
    display: block;
    width: 100%;
    height: auto;
  }

  .wristband-copy {
    margin: 0 0 1.35rem;
    max-width: 42rem;
  }

  .wristband-copy p {
    margin: 0 0 0.9rem;
    white-space: pre-wrap;
  }

  .wristband-copy p:first-child {
    font-family: var(--heading);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .wristband-copy p:last-child {
    margin-bottom: 0;
  }

  .wristband-art {
    display: block;
    width: min(220px, 100%);
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0 auto 0.25rem;
    background: var(--cream-deep);
    border: 1px solid var(--rule);
    border-radius: var(--radius-img);
  }

  .sponsor-art {
    display: block;
    width: 4.75rem;
    height: 4.75rem;
    margin: 0 0 0.75rem;
  }

  .sponsor-intro {
    margin: 0 0 1.1rem;
    max-width: 42rem;
  }

  .sponsor-blurb {
    margin: 0.55rem 0 0;
    font-size: 0.95rem;
  }

  .product.is-current {
    border-color: var(--ochre);
    box-shadow: inset 0 3px 0 var(--ochre);
  }

  .tier-now {
    font-family: var(--heading);
    font-weight: 700;
    margin: 0.35rem 0 0;
  }

  .product:not(.is-current) .tier-now {
    display: none !important;
  }

  .wristband-after {
    margin-top: 0.85rem;
  }

  section + section {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .halloween-back {
    margin-top: 2rem;
  }

  @keyframes flyer-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -0.45rem;
    }
  }

  @media (max-width: 640px) {
    .flyer-ghost {
      width: 3.25rem;
    }

    .flyer-ghost-a {
      top: 0.45rem;
    }

    .flyer-ghost-b {
      top: 0.7rem;
      width: 2.8rem;
    }

    .halloween-store :global(.page-hero) {
      padding-top: 4.8rem;
    }

    .product-actions .btn {
      display: block;
      width: 100%;
    }
  }

  @media (min-width: 720px) {
    .halloween-festive img {
      max-height: 240px;
    }

    .halloween-store .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 860px) {
    .wristband-layout {
      display: grid;
      grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
      gap: 1.25rem;
      align-items: start;
    }

    .wristband-art {
      width: 100%;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flyer-ghost {
      animation: none;
    }
  }
</style>
