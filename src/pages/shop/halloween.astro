---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import HalloweenCheckoutGate from '../../components/HalloweenCheckoutGate.astro';
import ZeffyCheckout from '../../components/ZeffyCheckout.astro';
import { asset, contactEmail, withBase } from '../../lib/site';
import {
  carnivalNonprofitSentence,
  currentWristbandTierNow,
  sponsorships,
  sponsorshipZeffyBuyHref,
  sponsorshipZeffyFormLink,
  wristbandTiers,
  wristbandZeffyBuyHref,
  wristbandZeffyFormLink,
} from '../../lib/halloween-shop';

const currentTier = currentWristbandTierNow();
---

<Base
  title="Halloween Carnival"
  description="Halloween Carnival wristbands and sponsorships for the MBMA Parents Group."
>
  <div class="halloween-store">
    <PageHero
      title="Halloween Carnival"
      eyebrow="School carnival"
      lede="Wristbands and sponsorships for the MBMA Halloween Carnival."
    />
    <main id="main">
      <div class="wrap">
        <figure class="halloween-festive">
          <img
            src={asset('images/gallery/halloween-pumpkins.jpg')}
            alt="Decorated pumpkins at an MBMA Halloween contest"
            width="1200"
            height="800"
          />
        </figure>

        <section aria-labelledby="wristbands-heading">
          <h2 id="wristbands-heading" class="section-title">Wristbands</h2>
          <img
            class="wristband-art"
            src={asset('images/shop/halloween-wristband.jpg')}
            alt="Orange treat bag and orange wristband"
            width="1080"
            height="1080"
          />
          <div class="product-grid">
            {
              wristbandTiers.map((tier) => {
                const appliesNow = tier.id === currentTier;
                return (
                  <article
                    class:list={['product', { 'is-current': appliesNow }]}
                    data-wristband-tier={tier.id}
                  >
                    <h2>Halloween Carnival Wristband</h2>
                    <p class="price">{tier.price}</p>
                    <p class="muted">{tier.window}</p>
                    <p class="tier-now" hidden={!appliesNow}>
                      This price applies now
                    </p>
                  </article>
                );
              })
            }
          </div>
          <p class="muted wristband-after" data-wristband-after hidden={currentTier !== null}>
            These listed prices apply through October 29, 2026.
          </p>
          <div class="shop-notice" role="note">
            <p class="shop-notice-title">Set Zeffy’s tip to $0</p>
            <p>
              At checkout, Zeffy may ask for an optional tip. Set that to <strong>$0</strong>. It goes
              to Zeffy, not to MBMA or the parents group.
            </p>
            <p class="shop-notice-contact">
              Questions? Email the board at{' '}
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
            </p>
          </div>
          <HalloweenCheckoutGate
            href={wristbandZeffyBuyHref}
            formLink={wristbandZeffyFormLink}
            label="Buy a wristband"
          />
        </section>

        <section aria-labelledby="sponsorships-heading">
          <h2 id="sponsorships-heading" class="section-title">Sponsorships</h2>
          <p>{carnivalNonprofitSentence}</p>
          <div class="product-grid">
            {
              sponsorships.map((item) => (
                <article class="product">
                  <h2>{item.name}</h2>
                  <p class="price">{item.price}</p>
                  {item.blurb ? <p class="sponsor-blurb">{item.blurb}</p> : null}
                </article>
              ))
            }
          </div>
          <div class="shop-notice" role="note">
            <p class="shop-notice-title">Set Zeffy’s tip to $0</p>
            <p>
              At checkout, Zeffy may ask for an optional tip. Set that to <strong>$0</strong>. It goes
              to Zeffy, not to MBMA or the parents group.
            </p>
            <p class="shop-notice-contact">
              Questions? Email the board at{' '}
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
            </p>
          </div>
          <HalloweenCheckoutGate
            href={sponsorshipZeffyBuyHref}
            formLink={sponsorshipZeffyFormLink}
            label="Buy a sponsorship"
          />
        </section>

        <p class="halloween-back">
          <a href={withBase('shop')}>Back to the shop</a>
        </p>
      </div>
    </main>
  </div>
  <ZeffyCheckout />
</Base>

<script>
  import { checkoutBoxesReady, currentWristbandTierNow } from '../../lib/halloween-shop';

  document.querySelectorAll('[data-checkout-gate]').forEach((gate) => {
    const boxes = [...gate.querySelectorAll('input[type="checkbox"]')].filter(
      (box): box is HTMLInputElement => box instanceof HTMLInputElement,
    );
    const buy = gate.querySelector('a[href]');
    if (!(buy instanceof HTMLAnchorElement) || boxes.length !== 2) return;

    const sync = () => {
      const ready = checkoutBoxesReady(boxes.map((box) => box.checked));
      buy.classList.toggle('is-blocked', !ready);
      buy.setAttribute('aria-disabled', ready ? 'false' : 'true');
      if (ready) buy.removeAttribute('tabindex');
      else buy.setAttribute('tabindex', '-1');
    };

    boxes.forEach((box) => box.addEventListener('change', sync));
    buy.addEventListener(
      'click',
      (event) => {
        if (buy.getAttribute('aria-disabled') !== 'false') {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true,
    );
    sync();
  });

  const tier = currentWristbandTierNow();
  document.querySelectorAll('[data-wristband-tier]').forEach((el) => {
    const appliesNow = el.getAttribute('data-wristband-tier') === tier;
    el.classList.toggle('is-current', appliesNow);
    const flag = el.querySelector('.tier-now');
    if (flag instanceof HTMLElement) flag.hidden = !appliesNow;
  });
  const after = document.querySelector('[data-wristband-after]');
  if (after instanceof HTMLElement) after.hidden = tier !== null;
</script>

<style>
  .halloween-store :global(.page-hero) {
    background: linear-gradient(180deg, #efe6f8 0%, var(--cream-deep) 100%);
  }

  .halloween-store :global(.page-hero .eyebrow) {
    color: #6b4c8a;
  }

  .halloween-festive {
    margin: 0 0 1.5rem;
  }

  .halloween-festive img {
    display: block;
    width: 100%;
    max-height: 240px;
    object-fit: cover;
    object-position: center 42%;
    background: var(--cream-deep);
    border: 1px solid var(--rule);
    border-radius: var(--radius-img);
  }

  .shop-notice {
    background: color-mix(in srgb, var(--peach) 42%, var(--white));
    border: 1px solid color-mix(in srgb, var(--peach) 58%, var(--rule));
    border-top: 3px solid var(--peach);
    border-radius: var(--radius);
    padding: 1rem 1.15rem 0.95rem;
    margin: 1.15rem 0 0;
  }

  .shop-notice-title {
    font-family: var(--heading);
    font-weight: 700;
    font-size: 1.08rem;
    margin: 0 0 0.3rem;
  }

  .shop-notice p {
    margin: 0;
  }

  .shop-notice-title + p {
    margin-top: 0.15rem;
  }

  .shop-notice-contact {
    margin-top: 0.75rem;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in srgb, var(--peach) 55%, var(--rule));
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .product-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 0.85rem 0 0;
  }

  .wristband-art {
    display: block;
    width: min(280px, 100%);
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0 0 1rem;
    background: var(--cream-deep);
    border: 1px solid var(--rule);
    border-radius: var(--radius-img);
  }

  .sponsor-blurb {
    margin: 0.55rem 0 0;
    font-size: 0.95rem;
  }

  .product.is-current {
    border-color: var(--ochre);
    box-shadow: inset 0 3px 0 var(--ochre);
  }

  .tier-now {
    font-family: var(--heading);
    font-weight: 700;
    margin: 0.35rem 0 0;
  }

  .wristband-after {
    margin-top: 0.85rem;
  }

  section + section {
    margin-top: 2.2rem;
  }

  .halloween-back {
    margin-top: 1.6rem;
  }
</style>
