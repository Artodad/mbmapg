---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ZeffyCheckout from '../../components/ZeffyCheckout.astro';
import ZeffyTipNotice from '../../components/ZeffyTipNotice.astro';
import { asset, withBase } from '../../lib/site';
import {
  carnivalNonprofitSentence,
  currentWristbandTierNow,
  sponsorships,
  sponsorshipZeffyBuyHref,
  sponsorshipZeffyFormLink,
  wristbandTiers,
  wristbandZeffyBuyHref,
  wristbandZeffyFormLink,
} from '../../lib/halloween-shop';

const currentTier = currentWristbandTierNow();
---

<Base
  title="Halloween Carnival"
  description="Halloween Carnival wristbands and sponsorships for the MBMA Parents Group."
>
  <div class="halloween-store">
    <div class="flyer-ghosts" aria-hidden="true">
      <svg class="flyer-ghost flyer-ghost-a" viewBox="0 0 64 80" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="#fffdf8"
          stroke="#c4b0e0"
          stroke-width="2"
          d="M32 8c-14 0-22 12-22 26v28c4-6 8 6 12 0s8-6 12 0 8 6 12 0 8-6 8 0V34C54 20 46 8 32 8z"
        ></path>
        <ellipse cx="24" cy="34" rx="3.2" ry="4" fill="#4a3520"></ellipse>
        <ellipse cx="40" cy="34" rx="3.2" ry="4" fill="#4a3520"></ellipse>
        <path d="M24 46c3.2 5 12.8 5 16 0" fill="none" stroke="#4a3520" stroke-width="2" stroke-linecap="round"></path>
        <ellipse cx="18" cy="42" rx="3" ry="2" fill="#f6c3cb"></ellipse>
        <ellipse cx="46" cy="42" rx="3" ry="2" fill="#f6c3cb"></ellipse>
      </svg>
      <svg class="flyer-ghost flyer-ghost-b" viewBox="0 0 64 80" xmlns="http://www.w3.org/2000/svg">
        <path
          fill="#fffdf8"
          stroke="#c4b0e0"
          stroke-width="2"
          d="M32 10c-13 0-20 11-20 24v26c3.5-5 7.5 5 11 0s7.5-5 11 0 7.5 5 11 0 7-5 7 0V34C53 21 45 10 32 10z"
        ></path>
        <ellipse cx="24" cy="34" rx="3.2" ry="4" fill="#4a3520"></ellipse>
        <path d="M36 32c3.4 0 6 2 6 4.2" fill="none" stroke="#4a3520" stroke-width="2" stroke-linecap="round"></path>
        <path d="M22 46c4 6 16 6 20 0" fill="none" stroke="#4a3520" stroke-width="2" stroke-linecap="round"></path>
        <ellipse cx="18" cy="42" rx="3" ry="2" fill="#f6c3cb"></ellipse>
        <ellipse cx="46" cy="42" rx="3" ry="2" fill="#f6c3cb"></ellipse>
      </svg>
    </div>
    <PageHero
      title="Halloween Carnival"
      eyebrow="School carnival"
      lede="Wristbands and sponsorships for the MBMA Halloween Carnival."
    >
      <p class="carnival-banner">Beware: candy and face paint</p>
    </PageHero>
    <main id="main">
      <div class="wrap">
        <ZeffyTipNotice />
        <figure class="halloween-festive">
          <img
            src={asset('images/gallery/halloween-pumpkins.jpg')}
            alt="Decorated pumpkins at an MBMA Halloween contest"
            width="1200"
            height="800"
          />
        </figure>

        <section aria-labelledby="wristbands-heading">
          <h2 id="wristbands-heading" class="section-title">Wristbands</h2>
          <div class="wristband-layout">
            <img
              class="wristband-art"
              src={asset('images/shop/halloween-wristband.jpg')}
              alt="Orange treat bag and orange wristband"
              width="1080"
              height="1080"
            />
            <div class="wristband-details">
              <div class="product-grid">
                {
                  wristbandTiers.map((tier) => {
                    const appliesNow = tier.id === currentTier;
                    return (
                      <article
                        class:list={['product', { 'is-current': appliesNow }]}
                        data-wristband-tier={tier.id}
                      >
                        <h2>Halloween Carnival Wristband</h2>
                        <p class="price">{tier.price}</p>
                        <p class="muted">{tier.window}</p>
                        {
                          appliesNow ? (
                            <p class="tier-now">This price applies now</p>
                          ) : null
                        }
                      </article>
                    );
                  })
                }
              </div>
              <p class="muted wristband-after" data-wristband-after hidden={currentTier !== null}>
                These listed prices apply through October 29, 2026.
              </p>
              <p class="product-actions">
                <a class="btn btn-peach" href={wristbandZeffyBuyHref} zeffy-form-link={wristbandZeffyFormLink}>
                  Buy a wristband
                </a>
              </p>
            </div>
          </div>
        </section>

        <section aria-labelledby="sponsorships-heading">
          <h2 id="sponsorships-heading" class="section-title">Sponsorships</h2>
          <p class="sponsor-intro">{carnivalNonprofitSentence}</p>
          <div class="product-grid">
            {
              sponsorships.map((item) => (
                <article class="product">
                  <h2>{item.name}</h2>
                  <p class="price">{item.price}</p>
                  {item.blurb ? <p class="sponsor-blurb">{item.blurb}</p> : null}
                </article>
              ))
            }
          </div>
          <p class="product-actions">
            <a
              class="btn btn-peach"
              href={sponsorshipZeffyBuyHref}
              zeffy-form-link={sponsorshipZeffyFormLink}
            >
              Buy a sponsorship
            </a>
          </p>
        </section>

        <p class="halloween-back">
          <a href={withBase('shop')}>Back to the shop</a>
        </p>
      </div>
    </main>
  </div>
  <ZeffyCheckout />
</Base>

<script>
  import { currentWristbandTierNow } from '../../lib/halloween-shop';

  const tier = currentWristbandTierNow();
  const appliesNowLabel = 'This price applies now';
  document.querySelectorAll('[data-wristband-tier]').forEach((el) => {
    const appliesNow = el.getAttribute('data-wristband-tier') === tier;
    el.classList.toggle('is-current', appliesNow);
    const flag = el.querySelector('.tier-now');
    if (appliesNow) {
      if (!(flag instanceof HTMLElement)) {
        const note = document.createElement('p');
        note.className = 'tier-now';
        note.textContent = appliesNowLabel;
        const scope = [...el.attributes].find((attr) => attr.name.startsWith('data-astro-cid'));
        if (scope) note.setAttribute(scope.name, scope.value);
        el.append(note);
      }
      return;
    }
    flag?.remove();
  });
  const after = document.querySelector('[data-wristband-after]');
  if (after instanceof HTMLElement) after.hidden = tier !== null;
</script>

<style>
  .halloween-store {
    position: relative;
  }

  .flyer-ghosts {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto 0;
    height: 7rem;
    pointer-events: none;
  }

  .flyer-ghost {
    position: absolute;
    width: 4.4rem;
    height: auto;
    animation: flyer-float 5.2s ease-in-out infinite;
  }

  .flyer-ghost-a {
    left: max(0.6rem, calc(50% - 24rem));
    top: 0.85rem;
  }

  .flyer-ghost-b {
    right: max(0.6rem, calc(50% - 22rem));
    top: 1.35rem;
    width: 3.7rem;
    animation-duration: 6.4s;
    animation-delay: -2s;
  }

  .carnival-banner {
    display: inline-block;
    max-width: 100%;
    margin: 0.85rem 0 0;
    padding: 0.45rem 0.85rem;
    background: var(--cream);
    color: #6b4c8a;
    border: 3px dashed #e07a2f;
    border-radius: 999px;
    font-family: var(--heading);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.35;
    text-align: center;
  }

  .halloween-store :global(.page-hero) {
    background: linear-gradient(180deg, #efe6f8 0%, var(--cream-deep) 100%);
    padding-top: 6.6rem;
  }

  .halloween-store :global(.page-hero .wrap) {
    min-width: 0;
  }

  .halloween-store :global(.page-hero .eyebrow) {
    color: #6b4c8a;
  }

  .halloween-festive {
    margin: 0 0 1.5rem;
  }

  .halloween-festive img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--cream-deep);
    border: 1px solid var(--rule);
    border-radius: var(--radius-img);
  }

  .halloween-store .product-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
  }

  .halloween-store .product {
    min-width: 0;
  }

  .halloween-store .product h2 {
    overflow-wrap: break-word;
  }

  .wristband-layout,
  .wristband-details {
    min-width: 0;
  }

  .product-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 1rem 0 0;
  }

  .product-actions .btn {
    max-width: 100%;
    text-align: center;
  }

  .wristband-art {
    display: block;
    width: min(100%, 32rem);
    height: auto;
    margin: 0 auto 0.25rem;
    background: var(--cream-deep);
    border: 1px solid var(--rule);
    border-radius: var(--radius-img);
  }

  .sponsor-intro {
    margin: 0 0 1.1rem;
    max-width: 42rem;
  }

  .sponsor-blurb {
    margin: 0.55rem 0 0;
    font-size: 0.95rem;
  }

  .product.is-current {
    border-color: var(--ochre);
    box-shadow: inset 0 3px 0 var(--ochre);
  }

  .tier-now {
    font-family: var(--heading);
    font-weight: 700;
    margin: 0.35rem 0 0;
  }

  .product:not(.is-current) .tier-now {
    display: none !important;
  }

  .wristband-after {
    margin-top: 0.85rem;
  }

  section + section {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .halloween-back {
    margin-top: 2rem;
  }

  @keyframes flyer-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -0.45rem;
    }
  }

  @media (max-width: 640px) {
    .flyer-ghost {
      width: 3.25rem;
    }

    .flyer-ghost-a {
      top: 0.45rem;
    }

    .flyer-ghost-b {
      top: 0.7rem;
      width: 2.8rem;
    }

    .halloween-store :global(.page-hero) {
      padding-top: 4.8rem;
    }

    .product-actions .btn {
      display: block;
      width: 100%;
    }
  }

  @media (min-width: 720px) {
    .halloween-store .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .wristband-layout {
      display: grid;
      grid-template-columns: minmax(16rem, 32rem) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }

    .wristband-art {
      width: 100%;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flyer-ghost {
      animation: none;
    }
  }
</style>
