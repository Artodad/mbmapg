---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import MonthCalendar from '../components/MonthCalendar.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import SeasonalArt from '../components/SeasonalArt.astro';
import { asset, withBase } from '../lib/site';
import { homeGallery } from '../lib/gallery';
import { formatEventWhen, monthNames, octoberSpotlightEvents } from '../lib/pg-events';

const heroPhoto = asset('images/gallery/jog-a-thon-group.jpg');
const octoberEvents = octoberSpotlightEvents();
const carnivalLights = Array.from({ length: 14 }, (_, index) => index % 3);
---

<Base
  title="Home"
  description="MBMA Parents Group — support, enrichment, and family events for Mission Bay Montessori Academy."
>
  <section class="home-hero">
    <div class="home-hero-media" style={`background-image: url('${heroPhoto}')`}></div>
    <div class="home-hero-season" aria-hidden="true">
      <SeasonalArt kind="bat" class="hw-hero-bat" />
      <SeasonalArt kind="bat" class="hw-hero-bat-2" />
      <SeasonalArt kind="candy" class="hw-hero-candy" />
      <SeasonalArt kind="candy" class="hw-hero-candy-2" />
      <SeasonalArt kind="pumpkin" class="hw-hero-pumpkin" />
      <SeasonalArt kind="pumpkin" class="hw-hero-pumpkin-sm" />
    </div>
    <div class="wrap home-hero-inner">
      <p class="eyebrow">Mission Bay Montessori Academy</p>
      <h1>Welcome to MBMA Parents Group</h1>
      <p class="lede">Open to all parents at Mission Bay Montessori Academy.</p>
      <p class="hw-hero-chip">Family-friendly October on the PG calendar</p>
    </div>
  </section>
  <main id="main" class="home-main">
    <section class="section">
      <div class="wrap">
        <div class="home-column">
          <div class="hw-spotlight">
            <div class="hw-lights" aria-hidden="true">
              {carnivalLights.map((tone) => <span class:list={['hw-bulb', `hw-bulb-${tone}`]}></span>)}
            </div>
            <h2 class="section-title">October gatherings</h2>
            <p class="muted hw-spotlight-lede">
              Family-friendly Parents Group events already on the 2026–27 calendar.
            </p>
            {
              octoberEvents.map((event) => (
                <EventCard
                  title={event.title}
                  month={monthNames[Number(event.start.slice(5, 7)) - 1].slice(0, 3)}
                  day={String(Number(event.start.slice(8)))}
                  meta={formatEventWhen(event)}
                  blurb={event.detail ?? 'On the Parents Group calendar.'}
                  href="events"
                  cta="See events"
                />
              ))
            }
          </div>
          <p class="muted hw-featured-fallback">
            No upcoming featured events right now.
            <a href={withBase('calendar')}>Check the calendar</a>
            for the Parents Group schedule.
          </p>

          <article class="event-card home-deadline">
            <div class="event-date" aria-hidden="true">
              <span class="month">Sep</span>
              <span class="day">11</span>
            </div>
            <div>
              <h2>Pizza Lunch</h2>
              <p class="event-meta">Deadline to order: Friday, September 11</p>
              <p>First pizza lunch is Friday, September 18th</p>
              <p class="actions">
                <a class="btn" href={withBase('pizza-lunch')}>Pizza lunch details</a>
              </p>
            </div>
          </article>

          <div class="home-actions">
            <article class="card">
              <h2>Volunteer</h2>
              <p>Classroom help, events, and other ways to pitch in.</p>
              <p>
                <a class="btn" href={withBase('volunteer')}>Volunteer</a>
              </p>
            </article>
            <article class="card">
              <h2>Donate</h2>
              <p>Support enrichment, events, and classroom needs.</p>
              <p>
                <a class="btn btn-gold" href={withBase('give')}>Donate</a>
              </p>
            </article>
            <article class="card">
              <h2>Send a receipt</h2>
              <p>Photo or upload a receipt for reimbursement to the treasurer.</p>
              <p>
                <a class="btn btn-gold" href={withBase('receipt')}>Send a receipt</a>
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap wrap-gallery">
        <h2 class="section-title">Gallery</h2>
        <PhotoGallery items={homeGallery} label="School photo gallery" />
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Parents Group events 2026–27</h2>
        <MonthCalendar />
      </div>
    </section>
  </main>
</Base>
