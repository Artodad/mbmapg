---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import MonthCalendar from '../components/MonthCalendar.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { asset, withBase } from '../lib/site';
import { homeGallery } from '../lib/gallery';
import {
  eventDayLabel,
  eventMonthShort,
  eventPageHref,
  formatEventWhen,
  homeComingUp,
} from '../lib/pg-events';

const heroPhoto = asset('images/gallery/jog-a-thon-group.jpg');
const comingUp = homeComingUp();
---

<Base
  title="Home"
  description="MBMA Parents Group — support, enrichment, and family events for Mission Bay Montessori Academy."
>
  <section class="home-hero">
    <div class="home-hero-media" style={`background-image: url('${heroPhoto}')`}></div>
    <div class="wrap home-hero-inner">
      <p class="eyebrow">Mission Bay Montessori Academy</p>
      <h1>Welcome to MBMA Parents Group</h1>
      <p class="lede">Open to all parents at Mission Bay Montessori Academy.</p>
    </div>
  </section>
  <main id="main" class="home-main">
    <section class="section-band home-coming" aria-labelledby="home-coming-title">
      <div class="wrap">
        <h2 class="section-title" id="home-coming-title">Coming up</h2>
        {
          comingUp.length ? (
            <div class="home-coming-grid" data-count={comingUp.length}>
              {comingUp.map((event) => {
                const href = eventPageHref(event);
                return (
                  <EventCard
                    heading="h3"
                    title={event.title}
                    month={eventMonthShort(event)}
                    day={eventDayLabel(event)}
                    meta={formatEventWhen(event)}
                    blurb={event.detail}
                    href={href}
                    cta={href === 'events' ? 'View events' : 'Event details'}
                  />
                );
              })}
            </div>
          ) : (
            <div class="home-coming-empty">
              <p class="home-coming-kicker">Parents Group calendar</p>
              <h3>The year is on the calendar</h3>
              <p>
                Browse Parents Group dates and mark what works for your family.
              </p>
              <p>
                <a class="btn" href={withBase('calendar')}>View the calendar</a>
              </p>
            </div>
          )
        }
        {
          comingUp.length ? (
            <p class="home-coming-more">
              <a href={withBase('events')}>All upcoming events</a>
            </p>
          ) : null
        }
      </div>
    </section>

    <section class="section home-tools">
      <div class="wrap">
        <div class="home-actions">
          <article class="card">
            <h2>Volunteer</h2>
            <p>Classroom help, events, and other ways to pitch in.</p>
            <p>
              <a class="btn" href={withBase('volunteer')}>Volunteer</a>
            </p>
          </article>
          <article class="card">
            <h2>Donate</h2>
            <p>Support enrichment, events, and classroom needs.</p>
            <p>
              <a class="btn" href={withBase('give')}>Donate</a>
            </p>
          </article>
          <article class="card">
            <h2>Send a receipt</h2>
            <p>Photo or upload a receipt for reimbursement to the treasurer.</p>
            <p>
              <a class="btn" href={withBase('receipt')}>Send a receipt</a>
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap wrap-gallery">
        <h2 class="section-title">Gallery</h2>
        <PhotoGallery items={homeGallery} label="School photo gallery" />
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Parents Group events 2026–27</h2>
        <MonthCalendar />
      </div>
    </section>
  </main>
</Base>
