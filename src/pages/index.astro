---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import PhotoWall from '../components/PhotoWall.astro';
import { calendarPdf, asset, withBase } from '../lib/site';
import { homeGallery } from '../lib/gallery';

const heroPhoto = asset('images/gallery/jog-a-thon-group.jpg');
---

<Base
  title="Home"
  description="MBMA Parents Group — support, enrichment, and family events for Mission Bay Montessori Academy."
>
  <section class="home-hero">
    <div class="home-hero-media" style={`background-image: url('${heroPhoto}')`}></div>
    <div class="wrap home-hero-inner">
      <p class="eyebrow">Mission Bay Montessori Academy</p>
      <h1>Welcome to MBMA Parents Group</h1>
      <p class="lede">Open to all parents at Mission Bay Montessori Academy.</p>
    </div>
  </section>
  <main id="main" class="home-main">
    <section class="section">
      <div class="wrap">
        <EventCard
          heading="h2"
          title="Welcome Back Meet & Greet"
          month="Aug"
          day="22"
          meta="Sat, Aug 22 · San Diego"
          blurb="Join us at Standley Park as we welcome in the new school year."
          href="events/welcome-back-meet-greet"
        />

        <article class="event-card home-deadline">
          <div class="event-date" aria-hidden="true">
            <span class="month">Sep</span>
            <span class="day">11</span>
          </div>
          <div>
            <h2>Pizza Lunch</h2>
            <p class="event-meta">Deadline to order: Friday, September 11</p>
            <p>First pizza lunch is Friday, September 18th</p>
            <p class="actions">
              <a class="btn" href={withBase('pizza-lunch')}>Pizza lunch details</a>
              <a href={withBase('shop')}>Shop pizza</a>
            </p>
          </div>
        </article>

        <div class="home-actions">
          <article class="card">
            <h2>Volunteer</h2>
            <p>Check out the many ways YOU can get more involved with MBMA's Parents Group!</p>
            <p>
              <a class="btn" href={withBase('volunteer')}>Volunteer</a>
            </p>
          </article>
          <article class="card">
            <h2>Donate</h2>
            <p>There are many ways to contribute to the MBMA PARENTS GROUP!</p>
            <p>
              <a class="btn btn-gold" href={withBase('give')}>Donate</a>
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap wrap-gallery">
        <h2 class="section-title">Gallery</h2>
        <PhotoWall items={homeGallery} class="gallery-home" />
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section-title">Calendar</h2>
        <p>
          <a href={withBase('calendar')}>Calendar</a>
          ·
          <a href={calendarPdf}>2025-2026 calendar PDF</a>
        </p>
      </div>
    </section>
  </main>
</Base>
