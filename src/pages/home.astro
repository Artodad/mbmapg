---
import Base from '../layouts/Base.astro';
import MonthCalendar from '../components/MonthCalendar.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { withBase, wixDonateUrl, wixShopUrl } from '../lib/site';
import { homeGallery } from '../lib/gallery';
import { formatEventDate, nextUpcomingEvent, todayISO } from '../lib/pg-events';
import { Content as AboutCopy } from '../content/about.md';

const today = todayISO();
const spotlight = nextUpcomingEvent(today);
const pizzaDeadline = '2026-09-11';
const showPizza = today <= pizzaDeadline;
---

<Base
  title="Home"
  description="MBMA Parents Group — support, enrichment, and family events for Mission Bay Montessori Academy."
>
  <main id="main" class="home-main">
    <div class="home-above-fold">
      <section class="home-first">
        <div class="wrap">
          <p class="home-tagline">Open to all parents at Mission Bay Montessori Academy.</p>
          {
            spotlight && (
              <a class="home-spotlight" href={withBase('events')}>
                <p class="home-spotlight-date">{formatEventDate(spotlight.start)}</p>
                <h1 class="home-spotlight-title">{spotlight.title}</h1>
                <p class="home-spotlight-place">{spotlight.detail ?? 'Mission Bay Montessori Academy'}</p>
              </a>
            )
          }
          <div class="home-cta-stack">
            <a class="home-cta home-cta-volunteer" href={withBase('volunteer')}>Volunteer</a>
            <a class="home-cta home-cta-donate" href={wixDonateUrl}>Donate</a>
          </div>
        </div>
      </section>

      {
        showPizza && (
          <section class="section home-below home-pizza">
            <div class="wrap">
              <div class="home-column">
                <article class="event-card home-deadline">
                  <div class="event-date" aria-hidden="true">
                    <span class="month">Sep</span>
                    <span class="day">11</span>
                  </div>
                  <div>
                    <h2>Pizza Lunch</h2>
                    <p class="event-meta">Deadline to order: Friday, September 11</p>
                    <p>First pizza lunch is Friday, September 18th</p>
                    <p class="actions">
                      <a class="btn btn-gold" href={wixShopUrl}>Order pizza lunch</a>
                    </p>
                  </div>
                </article>
              </div>
            </div>
          </section>
        )
      }
    </div>

    <section class="section home-below home-gallery">
      <div class="wrap wrap-gallery">
        <h2 class="section-title">Gallery</h2>
        <PhotoGallery items={homeGallery} label="School photo gallery" />
      </div>
    </section>

    <section class="section home-below">
      <div class="wrap">
        <h2 class="section-title">Parents Group events 2026–27</h2>
        <MonthCalendar />
      </div>
    </section>

    <section class="section home-below">
      <div class="wrap prose">
        <h2 class="section-title">About</h2>
        <AboutCopy />
      </div>
    </section>
  </main>
</Base>
