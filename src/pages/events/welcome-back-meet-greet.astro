---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { Content } from '../../content/welcome-back.md';
import { asset } from '../../lib/site';
---

<Base title="Welcome Back Meet & Greet" description="Join us at Standley Park as we welcome in the new school year.">
  <PageHero title="Welcome Back Meet & Greet" lede="Sat, Aug 22 | San Diego" />
  <main id="main">
    <div class="wrap prose">
      <img
        class="event-flyer"
        src={asset('images/events/welcome-back-meet-greet.png')}
        alt="Welcome Back Meet & Greet flyer for Saturday, August 22nd"
      />
      <Content />
    </div>
  </main>
</Base>
