---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../lib/site';
---

<Base title="Events" description="Upcoming MBMA Parents Group events.">
  <PageHero title="Upcoming Events" />
  <main id="main">
    <div class="wrap">
      <p class="muted">No upcoming events right now.</p>
      <p class="muted" style="margin-top: 1.4rem;">
        <a href={withBase('calendar')}>View the full calendar</a>
      </p>
    </div>
  </main>
</Base>
