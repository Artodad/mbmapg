---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EventCard from '../components/EventCard.astro';
import { asset, withBase } from '../lib/site';
---

<Base title="Events" description="Upcoming MBMA Parents Group events.">
  <PageHero title="Upcoming Events" />
  <main id="main">
    <div class="wrap">
      <img
        class="event-flyer"
        src={asset('images/events/welcome-back-meet-greet.png')}
        alt="Welcome Back Meet & Greet flyer for Saturday, August 22nd"
      />
      <EventCard
        title="Welcome Back Meet & Greet"
        month="Aug"
        day="22"
        meta="Aug 22, 2026, 10:00 AM – 12:00 PM · San Diego, 3585 Governor Dr, San Diego, CA 92122, USA"
        blurb="Join us at Standley Park as we welcome in the new school year."
        href="events/welcome-back-meet-greet"
        gold
      />
      <p class="muted" style="margin-top: 1.4rem;">
        <a href={withBase('calendar')}>View the full calendar</a>
      </p>
    </div>
  </main>
</Base>
