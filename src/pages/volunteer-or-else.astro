<script>
  const page = document.querySelector('.voe-page');
  const faces = document.querySelector('.voe-faces');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (page instanceof HTMLElement && faces instanceof HTMLElement) {
    const setGaze = (x: number, y: number) => {
      page.style.setProperty('--gaze-x', `${x}px`);
      page.style.setProperty('--gaze-y', `${y}px`);
    };

    const follow = (event: PointerEvent, strengthX: number, strengthY: number) => {
      const box = faces.getBoundingClientRect();
      const nx = (event.clientX - box.left) / box.width - 0.5;
      const ny = (event.clientY - box.top) / box.height - 0.5;
      page.classList.add('is-watching');
      setGaze(nx * strengthX, ny * strengthY);
    };

    faces.addEventListener('pointermove', (event) => follow(event, 10, 6));
    page.addEventListener('pointermove', (event) => {
      if (event.target === faces || faces.contains(event.target as Node)) return;
      const box = page.getBoundingClientRect();
      const nx = (event.clientX - box.left) / box.width - 0.5;
      const ny = (event.clientY - box.top) / box.height - 0.5;
      page.classList.add('is-watching');
      setGaze(nx * 7, ny * 4);
    });
    page.addEventListener('pointerleave', () => {
      page.classList.remove('is-watching');
      setGaze(0, 0);
    });

    let scareWait = 0;
    let scareHold = 0;

    const nextGap = () => 8000 + Math.random() * 4000;
    const holdMs = () => 1000 + Math.random() * 1000;

    const endScare = () => {
      page.classList.remove('is-horror');
      document.body.classList.remove('voe-horror-body');
    };

    const startScare = (hold = false) => {
      if (motion.matches) return;
      page.classList.add('is-horror');
      document.body.classList.add('voe-horror-body');
      window.clearTimeout(scareHold);
      if (hold) return;
      scareHold = window.setTimeout(endScare, holdMs());
    };

    const scheduleScare = () => {
      window.clearTimeout(scareWait);
      if (motion.matches) {
        endScare();
        return;
      }
      scareWait = window.setTimeout(() => {
        startScare();
        scheduleScare();
      }, nextGap());
    };

    const params = new URLSearchParams(window.location.search);
    const scareParam = params.get('scare');
    if (scareParam === 'hold') {
      startScare(true);
    } else if (scareParam === 'now') {
      startScare();
      scheduleScare();
    } else {
      scheduleScare();
    }
    motion.addEventListener('change', scheduleScare);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        window.clearTimeout(scareWait);
        window.clearTimeout(scareHold);
        endScare();
        return;
      }
      scheduleScare();
    });
  }
</script>

