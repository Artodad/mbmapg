const hearts = [
  { left: '3%', delay: '0s', size: '1.8rem', dur: '8s', drift: '18px' },
  { left: '12%', delay: '1.2s', size: '1.15rem', dur: '10s', drift: '-22px' },
  { left: '21%', delay: '3.4s', size: '2rem', dur: '7.5s', drift: '12px' },
  { left: '33%', delay: '0.6s', size: '1.3rem', dur: '11s', drift: '-16px' },
  { left: '47%', delay: '2.1s', size: '1.7rem', dur: '9s', drift: '24px' },
  { left: '59%', delay: '4s', size: '1.05rem', dur: '8.5s', drift: '-10px' },
  { left: '70%', delay: '1.8s', size: '2.1rem', dur: '12s', drift: '20px' },
  { left: '81%', delay: '3s', size: '1.4rem', dur: '7s', drift: '-18px' },
  { left: '91%', delay: '0.3s', size: '1.6rem', dur: '10.5s', drift: '14px' },
  { left: '7%', delay: '5.2s', size: '1.25rem', dur: '9.5s', drift: '8px' },
  { left: '86%', delay: '6s', size: '1.9rem', dur: '8.8s', drift: '-14px' },
];

const ticker =
  'WE’LL FIND YOU  ·  VOLUNTEER  ·  WE ALREADY KNOW PICKUP  ·  BRING NAPKINS  ·  PIZZA FRIDAYS  ·  STILL FIND YOU  ·  ';
const scareTicker =
  'WE FOUND YOU  ·  LOOK BEHIND YOU  ·  THE NAPKINS KNOW  ·  SIGN THE SHEET  ·  STILL WATCHING  ·  CARNIVAL NEVER FORGETS  ·  ';
