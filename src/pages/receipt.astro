---
import Base from '../layouts/Base.astro';
import { siteName, withBase } from '../lib/site';

const nextUrl = new URL(`${withBase('receipt').replace(/\/?$/, '/')}?sent=1`, Astro.site).href;
---

<Base title="Send a receipt" description="Photograph a receipt and send it to the MBMA Parents Group treasurer." bare>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search);
        var sent = q.get('sent') === '1' || q.get('sent') === 'true';
        var fromThanks = /formsubmit\.co/i.test(document.referrer);
        if (sent || fromThanks) document.documentElement.dataset.receiptSent = '1';
      })();
    </script>
  </Fragment>

  <header slot="chrome-header" class="receipt-header">
    <div class="receipt-wrap">
      <a class="receipt-wordmark" href={withBase()}>{siteName}</a>
    </div>
  </header>

  <main id="main" class="receipt-main">
    <div class="receipt-wrap">
      <h1>Send a receipt</h1>
      <p class="receipt-lede">Goes to Somesh, the treasurer.</p>

      <p class="receipt-sent">Sent to the treasurer.</p>

      <div class="receipt-flow">
        <form
          class="receipt-form"
          method="POST"
          enctype="multipart/form-data"
          action="https://formsubmit.co/treasurerpg@mbmapg.org"
        >
          <input type="hidden" name="_subject" value="Receipt from MBMA Parents Group" />
          <input type="hidden" name="_next" value={nextUrl} />
          <label class="receipt-honey" aria-hidden="true">
            Leave this empty
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" />
          </label>

          <div class="receipt-pickers">
            <label class="btn btn-gold receipt-tap">
              Photograph receipt
              <input
                class="visually-hidden"
                type="file"
                name="attachment"
                accept="image/*"
                capture="environment"
                required
                data-receipt-file
              />
            </label>
            <button type="button" class="receipt-choose" data-receipt-library>
              Or choose a photo
            </button>
          </div>

          <div class="receipt-after">
            <figure class="receipt-preview">
              <img data-receipt-preview alt="" />
              <figcaption>Receipt photo</figcaption>
            </figure>

            <label class="receipt-field">
              Your name
              <input type="text" name="Your name" autocomplete="name" required />
            </label>
            <label class="receipt-field">
              Amount
              <span class="receipt-amount">
                <span class="receipt-amount-prefix" aria-hidden="true">$</span>
                <input type="text" name="Amount" inputmode="decimal" autocomplete="off" />
              </span>
            </label>
            <label class="receipt-field">
              Date
              <input type="text" name="Date" placeholder="Today" data-receipt-date autocomplete="off" />
            </label>
            <label class="receipt-field">
              What it was for
              <input type="text" name="What it was for" autocomplete="off" />
            </label>

            <button type="submit" class="btn btn-gold receipt-tap">Send</button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Base>

<script>
  const fileInput = document.querySelector<HTMLInputElement>('[data-receipt-file]');
  const libraryButton = document.querySelector<HTMLButtonElement>('[data-receipt-library]');
  const preview = document.querySelector<HTMLImageElement>('[data-receipt-preview]');
  const dateInput = document.querySelector<HTMLInputElement>('[data-receipt-date]');

  if (dateInput && !dateInput.value) {
    dateInput.value = new Intl.DateTimeFormat('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    }).format(new Date());
  }

  if (fileInput) {
    fileInput.closest('label')?.addEventListener('pointerdown', () => {
      fileInput.setAttribute('capture', 'environment');
    });
  }

  libraryButton?.addEventListener('click', () => {
    if (!fileInput) return;
    fileInput.removeAttribute('capture');
    fileInput.click();
  });

  let previewUrl = '';
  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (!file || !preview) return;
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = URL.createObjectURL(file);
    preview.src = previewUrl;
    preview.alt = 'Receipt photo';
  });
</script>

<style>
  .receipt-header {
    height: 56px;
    background: #fff;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 60;
  }

  .receipt-wordmark {
    font-family: var(--heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--charcoal);
    text-decoration: none;
    line-height: 1;
  }

  .receipt-wordmark:hover {
    color: var(--ochre);
  }

  .receipt-main {
    padding: 1.35rem 0 2.75rem;
  }

  .receipt-wrap {
    width: min(22.5rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .receipt-main h1 {
    color: var(--charcoal);
    font-size: clamp(1.85rem, 7vw, 2.15rem);
    margin-bottom: 0.35rem;
  }

  .receipt-lede {
    color: var(--ink-muted);
    font-size: 0.95rem;
    margin: 0 0 1.35rem;
  }

  .receipt-sent {
    color: var(--charcoal);
    font-size: 1.05rem;
    margin: 0;
  }

  .receipt-form {
    margin: 0;
  }

  .receipt-honey {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .receipt-pickers {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
  }

  .receipt-tap {
    width: 100%;
    height: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--charcoal);
    text-transform: uppercase;
    border: 0;
    border-radius: 0;
    padding: 0 1rem;
    cursor: pointer;
    box-sizing: border-box;
  }

  .receipt-tap:hover {
    color: var(--charcoal);
  }

  .receipt-choose {
    display: block;
    width: 100%;
    background: none;
    border: 0;
    padding: 0;
    color: var(--ochre);
    text-decoration: underline;
    text-underline-offset: 0.14em;
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    text-align: center;
  }

  .receipt-choose:hover {
    color: var(--charcoal);
  }

  .receipt-form:has([name='attachment']:valid) .receipt-pickers {
    display: none;
  }

  .receipt-form:not(:has([name='attachment']:valid)) .receipt-after {
    display: none;
  }

  .receipt-preview {
    margin: 0 0 1.2rem;
    position: relative;
    background: #ddd8ce;
    min-height: 11.5rem;
  }

  .receipt-preview img {
    display: block;
    width: 100%;
    min-height: 11.5rem;
    max-height: 16rem;
    object-fit: cover;
    background: #ddd8ce;
  }

  .receipt-preview img:not([src]) {
    visibility: hidden;
  }

  .receipt-preview figcaption {
    position: absolute;
    left: 0.65rem;
    bottom: 0.5rem;
    margin: 0;
    font-size: 0.82rem;
    color: var(--charcoal);
  }

  .receipt-field {
    display: grid;
    gap: 0.28rem;
    margin: 0 0 0.95rem;
    color: var(--charcoal);
    font-size: 0.95rem;
  }

  .receipt-field input[type='text'] {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--rule);
    background: #fff;
    border-radius: 0;
    padding: 0.45rem 0.65rem;
    font: inherit;
    color: var(--charcoal);
  }

  .receipt-amount {
    display: flex;
    align-items: stretch;
    min-height: 44px;
    border: 1px solid var(--rule);
    background: #fff;
  }

  .receipt-amount-prefix {
    display: flex;
    align-items: center;
    padding: 0 0.15rem 0 0.7rem;
    color: var(--ink-muted);
    line-height: 1;
  }

  .receipt-amount input[type='text'] {
    border: 0;
    min-width: 0;
    flex: 1;
    padding-left: 0.35rem;
  }

  .receipt-amount input[type='text']:focus {
    outline: none;
  }

  .receipt-amount:focus-within {
    outline: 2px solid var(--ochre);
    outline-offset: 3px;
  }

  :global(html[data-receipt-sent='1']) .receipt-flow {
    display: none;
  }

  :global(html:not([data-receipt-sent='1'])) .receipt-sent {
    display: none;
  }
</style>
