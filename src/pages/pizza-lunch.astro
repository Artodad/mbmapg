---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { Content } from '../content/pizza-lunch.md';
import { asset } from '../lib/site';

const orderHref = 'https://www.zeffy.com/en-US/ticketing/pizza-lunch-fridays-fundraiser';
const orderZeffyFormLink =
  'https://www.zeffy.com/embed/ticketing/pizza-lunch-fridays-fundraiser?modal=true';
---

<Base title="Pizza lunch 2026–27" description="Pizza lunch 2026–27 — cheese pizza Fridays for the MBMA Parents Group.">
  <PageHero title="Pizza lunch 2026–27" />
  <main id="main">
    <div class="wrap prose">
      <img
        src={asset('images/pizza-day-fridays.png')}
        alt="Pizza Day Fridays, annual MBMA Parents Group fundraiser, cheese pizza only"
      />
      <Content />
      <p class="actions">
        <a class="btn btn-gold" href={orderHref} zeffy-form-link={orderZeffyFormLink}>
          Order pizza lunch
        </a>
      </p>
    </div>
  </main>
  <script
    is:inline
    src="https://zeffy-scripts.s3.ca-central-1.amazonaws.com/embed-form-script.min.js"></script>
  <script is:inline>
    document.addEventListener(
      'click',
      function (event) {
        var trigger = event.target.closest('a[zeffy-form-link]');
        if (!trigger) return;
        if (document.querySelector('iframe[title="Form powered and secured by Zeffy"]')) {
          event.preventDefault();
        }
      },
      true
    );
  </script>
</Base>
