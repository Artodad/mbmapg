---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { Content } from '../content/pizza-lunch.md';
import { asset, withBase } from '../lib/site';
---

<Base title="Pizza lunch 2026–27" description="Pizza lunch 2026–27 — cheese pizza Fridays for the MBMA Parents Group.">
  <PageHero title="Pizza lunch 2026–27" />
  <main id="main">
    <div class="wrap prose">
      <img
        src={asset('images/pizza-day-fridays.png')}
        alt="Pizza Day Fridays, annual MBMA Parents Group fundraiser, cheese pizza only"
      />
      <Content />
      <p class="actions">
        <a class="btn btn-gold" href={withBase('shop/pizza-lunch')}>Order pizza lunch</a>
      </p>
    </div>
  </main>
</Base>
