---
import '../styles/shop.css';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { orderEmail, withBase } from '../lib/site';
---

<Base title="Complete your order" description="How to finish an MBMA PG shop order.">
  <PageHero title="Complete your order" />
  <main id="main">
    <div class="wrap">
      <p class="banner-info" role="status">
        Online card payment is not available. Complete this order at the
        <a href={withBase('events/welcome-back-meet-greet')}>Welcome Back Meet &amp; Greet</a>
        or email
        <a href={`mailto:${orderEmail}`}>{orderEmail}</a>.
      </p>
      <div
        id="checkout-app"
        data-shop={withBase('shop')}
        data-cart={withBase('cart')}
        data-meet={withBase('events/welcome-back-meet-greet')}
        data-email={orderEmail}
      >
        <p class="muted">Loading order…</p>
      </div>
    </div>
  </main>
</Base>

<script>
  import {
    cartIsTeachersOnlyFree,
    cartTotalCents,
    loadAndMutate,
    loadCart,
    updateItemCustom,
    validatePizzaFields,
  } from '../lib/cart';
  import { formatCents, getProduct, lineLabel, unitAmountCents } from '../lib/products';

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  const root = document.getElementById('checkout-app');
  if (root) {
    const shopHref = root.dataset.shop ?? '/mbmapg/shop';
    const cartHref = root.dataset.cart ?? '/mbmapg/cart';
    const meetHref = root.dataset.meet ?? '/mbmapg/events/welcome-back-meet-greet';
    const email = root.dataset.email ?? 'parentsgroup@mbmapg.org';

    function orderText(): string {
      const cart = loadCart();
      const lines = cart.items.map((item) => {
        const product = getProduct(item.productSlug);
        const name = product ? lineLabel(product, item.variantId, item.sliceCount) : item.productSlug;
        const unit = product ? unitAmountCents(product, item.variantId) : 0;
        const extras = [
          item.custom?.studentFirst || item.custom?.studentLast
            ? `Student: ${item.custom.studentFirst ?? ''} ${item.custom.studentLast ?? ''}`.trim()
            : '',
          item.custom?.room ? `Room: ${item.custom.room}` : '',
          item.custom?.note ? `Note: ${item.custom.note}` : '',
        ]
          .filter(Boolean)
          .join('; ');
        return `- ${name} × ${item.quantity} = ${formatCents(unit * item.quantity)}${extras ? ` (${extras})` : ''}`;
      });
      lines.push(`Subtotal: ${formatCents(cartTotalCents(cart))}`);
      return lines.join('\n');
    }

    function mailtoHref(): string {
      const subject = encodeURIComponent('MBMA PG shop order');
      const body = encodeURIComponent(`Hello,\n\nI would like to place this shop order:\n\n${orderText()}\n`);
      return `mailto:${email}?subject=${subject}&body=${body}`;
    }

    function render() {
      if (!root) return;
      const cart = loadCart();
      if (cart.items.length === 0) {
        root.innerHTML = `<p class="cart-empty">Your cart is empty. <a href="${shopHref}">Continue shopping</a></p>`;
        return;
      }

      const teachersOnly = cartIsTeachersOnlyFree(cart);
      const rows = cart.items
        .map((item) => {
          const product = getProduct(item.productSlug);
          const name = product ? lineLabel(product, item.variantId, item.sliceCount) : item.productSlug;
          const unit = product ? unitAmountCents(product, item.variantId) : 0;
          const pizza = product ? validatePizzaFields(item, product).length >= 0 && product.requiredFields.includes('studentFirst') : false;
          const fields = pizza
            ? `<div class="line-fields">
                <label>Student first name <input type="text" data-field="studentFirst" data-id="${item.id}" value="${escapeHtml(item.custom?.studentFirst ?? '')}" required /></label>
                <label>Student last name <input type="text" data-field="studentLast" data-id="${item.id}" value="${escapeHtml(item.custom?.studentLast ?? '')}" required /></label>
                <label>Room # <input type="text" data-field="room" data-id="${item.id}" value="${escapeHtml(item.custom?.room ?? '')}" required /></label>
              </div>`
            : `<div class="line-fields">
                <label>Student first name &amp; room # (optional) <input type="text" data-field="note" data-id="${item.id}" value="${escapeHtml(item.custom?.note ?? '')}" /></label>
              </div>`;
          return `<tr>
            <td>
              <strong>${escapeHtml(name)}</strong>
              × ${item.quantity}
              ${fields}
            </td>
            <td>${formatCents(unit * item.quantity)}</td>
          </tr>`;
        })
        .join('');

      const notice = teachersOnly
        ? `<p class="banner-info" role="status">No payment needed — contact the board.</p>`
        : '';

      const actions = `<p class="checkout-actions">
            <a class="btn btn-gold" data-email-board href="${mailtoHref()}">Email ${email}</a>
            <a class="btn" href="${meetHref}">Meet &amp; Greet details</a>
            <a class="btn" href="${cartHref}">Back to order list</a>
          </p>`;

      root.innerHTML = `
        ${notice}
        <h2>Order summary</h2>
        <table class="cart-table">
          <thead><tr><th>Item</th><th>Total</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
        <p class="cart-subtotal">Subtotal: <strong>${formatCents(cartTotalCents(cart))}</strong></p>
        <p id="checkout-errors" class="banner-warn" hidden></p>
        ${actions}
      `;

      root.querySelectorAll<HTMLInputElement>('input[data-field]').forEach((input) => {
        input.addEventListener('input', () => {
          const id = input.dataset.id;
          const field = input.dataset.field;
          if (!id || !field) return;
          loadAndMutate((current) => updateItemCustom(current, id, { [field]: input.value }));
          const emailLink = root.querySelector<HTMLAnchorElement>('[data-email-board]');
          if (emailLink) emailLink.href = mailtoHref();
        });
      });

    }

    render();
  }
</script>
