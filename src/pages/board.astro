---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { asset, contactEmail } from '../lib/site';

const board = [
  {
    name: 'Stephanie Willett',
    role: 'President',
    year: '4th year at MBMA',
    email: 'presidentpg@mbmapg.org',
    photo: asset('images/board/stephanie-willett.jpg'),
  },
  {
    name: 'Jennifer Lin',
    role: 'Vice President',
    year: '9th year at MBMA',
    email: 'jennifer.Lin@mbmapg.org',
    photo: asset('images/board/jennifer-lin.jpeg'),
  },
  {
    name: 'Julia Solaegui',
    role: 'Secretary',
    year: '4th year at MBMA',
    email: 'secretarypg@mbmapg.org',
    photo: asset('images/board/julia-solaegui.jpg'),
  },
  {
    name: 'Somesh Maheshwari',
    role: 'Treasurer',
    year: '5th year at MBMA',
    email: contactEmail,
    emailLabel: `email ${contactEmail}`,
    photo: asset('images/board/somesh-maheshwari.jpeg'),
  },
];
---

<Base title="PG Board" description="Meet the MBMA Parents Group board.">
  <PageHero title="Meet Our Board" />
  <main>
    <div class="wrap">
      <div class="board-grid">
        {
          board.map((person) => (
            <article class="board-card">
              <img src={person.photo} alt={person.name} />
              <h2>{person.name}</h2>
              <p>{person.role}</p>
              <p class="muted">{person.year}</p>
              {person.email ? (
                <p>
                  <a href={`mailto:${person.email}`}>{'emailLabel' in person && person.emailLabel ? person.emailLabel : person.email}</a>
                </p>
              ) : null}
            </article>
          ))
        }
      </div>
    </div>
  </main>
</Base>
