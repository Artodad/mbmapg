---
import '../styles/shop.css';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import OrderHow from '../components/OrderHow.astro';
import { asset, withBase } from '../lib/site';
import { productGroups, productPriceLabel, productsInGroup } from '../lib/products';
---

<Base title="Shop" description="MBMA PG shop — pizza lunch, tees, and Path of Appreciation pavers.">
  <PageHero title="Shop" />
  <main id="main">
    <div class="wrap">
      <p>
        Pizza Fridays, PE tees, Path of Appreciation pavers, and seasonal items.
        Browse and save a list if you want.
        {' '}
        <a href={withBase('cart')}>Order list</a>
      </p>
      <OrderHow />
      {
        productGroups.map((group) => {
          const items = productsInGroup(group.id);
          if (!items.length) return null;
          return (
            <section class="shop-group" aria-labelledby={`shop-${group.id}`}>
              <h2 id={`shop-${group.id}`} class="shop-group-title">
                {group.label}
              </h2>
              <div class="product-grid">
                {items.map((product) => (
                  <article class="product">
                    {product.image ? (
                      <img
                        src={asset(product.image)}
                        alt={product.imagePlaceholder ? `${product.name} — photo not on the old shop` : product.name}
                        width="600"
                        height="600"
                      />
                    ) : (
                      <div class="product-photo-empty" aria-hidden="true"></div>
                    )}
                    {product.imagePlaceholder ? (
                      <p class="photo-note">Photo not on the old shop</p>
                    ) : null}
                    <h3>{product.name}</h3>
                    <p class="price">{productPriceLabel(product)}</p>
                    <p>{product.summary}</p>
                    <p class="product-actions">
                      <a class="btn" href={withBase(`shop/${product.slug}`)}>
                        View
                      </a>
                    </p>
                  </article>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </main>
</Base>

<style>
  .shop-group {
    margin: 2.2rem 0 2.6rem;
  }

  .shop-group-title {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    letter-spacing: 0.08em;
  }

  .product-grid {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .product h3 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }

  .product-photo-empty {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    background: var(--warm-gray);
  }
</style>
