---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { asset, withBase } from '../lib/site';
import { productGroups, productPriceLabel, productsInGroup } from '../lib/products';
---

<Base title="Shop" description="MBMA PG shop — pizza lunch, tees, and Path of Appreciation pavers.">
  <PageHero title="MBMA PG SHOP" />
  <main>
    <div class="wrap">
      <p>
        Pizza Fridays, PE tees, Path of Appreciation pavers, and seasonal items.
        Open a product to add it to your cart.
      </p>
      {
        productGroups.map((group) => {
          const items = productsInGroup(group.id);
          if (!items.length) return null;
          return (
            <section class="shop-group" aria-labelledby={`shop-${group.id}`}>
              <h2 id={`shop-${group.id}`} class="shop-group-title">
                {group.label}
              </h2>
              <div class="product-grid">
                {items.map((product) => (
                  <article class="product">
                    {product.image ? (
                      <img src={asset(product.image)} alt={product.name} width="600" height="600" />
                    ) : null}
                    <h3>{product.name}</h3>
                    <p class="price">{productPriceLabel(product)}</p>
                    <p>{product.summary}</p>
                    {product.slug === 'pizza-lunch' ? (
                      <p>
                        <a href={withBase('pizza-lunch')}>Pizza lunch details</a>
                      </p>
                    ) : null}
                    <p class="product-actions">
                      <a class="btn" href={withBase(`shop/${product.slug}`)}>
                        {product.variants?.some((variant) => variant.slices?.length)
                          ? 'Choose slices'
                          : 'View'}
                      </a>
                    </p>
                  </article>
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </main>
</Base>

<style>
  .shop-group {
    margin: 2.2rem 0 2.6rem;
  }

  .shop-group-title {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product h3 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }
</style>
