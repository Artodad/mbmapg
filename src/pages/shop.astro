---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { contactEmail, withBase } from '../lib/site';
import { products, productPriceLabel } from '../lib/products';
---

<Base title="Shop" description="MBMA PG shop — pizza lunch, tees, and Path of Appreciation pavers.">
  <PageHero title="MBMA PG SHOP" />
  <main>
    <div class="wrap">
      <p class="note">
        *Please put Students first name & room # in Company name field at checkout.
        On this site those are collected as real fields (required for pizza lunch).
      </p>
      <p>
        Add items to your cart and review them at checkout. Online card payments are
        not connected yet — you can email the board at
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a> or pay at the Welcome Back
        Meet &amp; Greet.
      </p>
      <div class="product-grid">
        {
          products.map((product) => (
            <article class="product">
              <h2>{product.name}</h2>
              <p class="price">{productPriceLabel(product)}</p>
              <p>{product.summary}</p>
              {product.slug === 'pizza-lunch' ? (
                <p>
                  <a href={withBase('pizza-lunch')}>Pizza lunch details</a>
                </p>
              ) : null}
              <div class="product-actions">
                <button
                  type="button"
                  class="btn"
                  data-add-to-cart
                  data-slug={product.slug}
                  data-variant={product.variants?.[0]?.id ?? ''}
                >
                  Add
                </button>
                <a class="btn btn-gold" href={withBase(`shop/${product.slug}`)}>
                  View
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <div class="prose">
        <h2>Path of Appreciation</h2>
        <p>
          MBMAPG would like to invite you to make a contribution to the Parents Group and in return,
          get your families name and a message displayed on a permanent concrete paver. The pavers
          will be placed in the “ Path of Appreciation ” located at the top of the main entrance,
          just outside the office. The path has two wood arbors at the points of entry, a bench for
          seating, and beautiful landscaping for students and families to enjoy. The benches will be
          placed outside of the classrooms for outdoor education. This will ensure that we receive
          the paver/bench by or before the end of the school year. Order your paver by March 26,
          2026 and leave your lasting footprint at MBMA! This will ensure that we receive the
          paver/bench by or before the end of the school year.
        </p>
      </div>
    </div>
  </main>
</Base>

<script>
  import { addItem, loadAndMutate } from '../lib/cart';

  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((button) => {
    button.addEventListener('click', () => {
      const slug = button.dataset.slug;
      if (!slug) return;
      const variantId = button.dataset.variant || undefined;
      loadAndMutate((cart) => addItem(cart, { productSlug: slug, variantId }));
      const previous = button.textContent;
      button.textContent = 'Added';
      window.setTimeout(() => {
        button.textContent = previous;
      }, 1200);
    });
  });
</script>
