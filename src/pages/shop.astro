---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { asset, contactEmail, withBase } from '../lib/site';

const products: {
  name: string;
  price: string;
  note?: string;
  href?: string;
  image?: string;
  buyHref: string;
  zeffyFormLink: string;
}[] = [
  {
    name: 'Pizza Lunch Fridays - Fundraiser',
    price: '$180.00',
    note: '1–2 / 3–5 / 6–8 slices: $180 / $240 / $300. See pizza lunch page for both vendor notes.',
    href: 'pizza-lunch',
    image: 'images/shop/pizza-lunch.png',
    buyHref: 'https://www.zeffy.com/en-US/ticketing/pizza-lunch-fridays-fundraiser',
    zeffyFormLink: 'https://www.zeffy.com/embed/ticketing/pizza-lunch-fridays-fundraiser?modal=true',
  },
  {
    name: 'PE/Field Trip Tee- Youth Blue',
    price: '$15.00',
    image: 'images/shop/pe-tee.jpg',
    buyHref: 'https://www.zeffy.com/en-US/ticketing/pefield-trip-tee-youth-blue',
    zeffyFormLink: 'https://www.zeffy.com/embed/ticketing/pefield-trip-tee-youth-blue?modal=true',
  },
  {
    name: 'PE/Field Trip Tee - Adult Blue',
    price: '$18.00',
    image: 'images/shop/pe-tee.jpg',
    buyHref: 'https://www.zeffy.com/en-US/ticketing/pefield-trip-tee-adult-blue',
    zeffyFormLink: 'https://www.zeffy.com/embed/ticketing/pefield-trip-tee-adult-blue?modal=true',
  },
  {
    name: 'Path of Appreciation Paver $500',
    price: '$500.00',
    note: '12x12 inch 7 Lines (20 characters per line) 2 Color options Tan Gray. Order your paver by March 26, 2026.',
    image: 'images/shop/paver.jpg',
    buyHref: 'https://www.zeffy.com/en-US/ticketing/path-of-appreciation-paver-dollar500',
    zeffyFormLink: 'https://www.zeffy.com/embed/ticketing/path-of-appreciation-paver-dollar500?modal=true',
  },
  {
    name: 'Path of Appreciation Paver $250',
    price: '$250.00',
    note: '8x8 inch 5 Lines (20 characters per line) 2 Color options Gray Beige. Order your paver by March 26, 2026.',
    image: 'images/shop/paver.jpg',
    buyHref: 'https://www.zeffy.com/en-US/ticketing/path-of-appreciation-paver-dollar250',
    zeffyFormLink: 'https://www.zeffy.com/embed/ticketing/path-of-appreciation-paver-dollar250?modal=true',
  },
  {
    name: 'Path of Appreciation Paver $100',
    price: '$100.00',
    note: '4x8 inch 2 Lines (20 characters per line) 2 Color options Tan Beige. Order your paver by March 26, 2026.',
    image: 'images/shop/paver.jpg',
    buyHref: 'https://www.zeffy.com/en-US/ticketing/path-of-appreciation-paver-dollar100',
    zeffyFormLink: 'https://www.zeffy.com/embed/ticketing/path-of-appreciation-paver-dollar100?modal=true',
  },
  {
    name: 'TEACHERS Pizza Lunch',
    price: '$0.00',
    note: 'Choice of 1-2 slices or 3-5 CHEESE ONLY Slices NOTE: Please be aware of that the slices are double cut (i.e: Usually a large is 8 slices, but now it will be 16 which means they will slightly smaller)',
    image: 'images/shop/teachers-pizza.png',
    buyHref: 'https://www.zeffy.com/en-US/ticketing/teachers-pizza-lunch',
    zeffyFormLink: 'https://www.zeffy.com/embed/ticketing/teachers-pizza-lunch?modal=true',
  },
];
---

<Base title="Shop" description="MBMA PG shop catalog. Checkout opens in a Zeffy popup.">
  <PageHero title="Shop" />
  <main id="main">
    <div class="wrap">
      <p class="note">
        *Please put Students first name & room # in Company name field at checkout.
      </p>
      <p>
        Checkout opens in a popup. For questions, email the board
        at{' '}
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>
      <div class="product-grid">
        {
          products.map((product) => (
            <article class="product">
              {product.image ? <img src={asset(product.image)} alt={product.name} /> : null}
              <h2>{product.name}</h2>
              <p class="price">{product.price}</p>
              {product.note ? <p class="muted">{product.note}</p> : null}
              <p class="product-actions">
                <a class="btn btn-peach" href={product.buyHref} zeffy-form-link={product.zeffyFormLink}>
                  Buy
                </a>
                {'href' in product && product.href ? (
                  <a href={withBase(product.href)}>Pizza lunch details</a>
                ) : null}
              </p>
            </article>
          ))
        }
      </div>
      <div class="prose">
        <h2>Path of Appreciation</h2>
        <p>
          MBMAPG would like to invite you to make a contribution to the Parents Group and in return,
          get your families name and a message displayed on a permanent concrete paver. The pavers
          will be placed in the “ Path of Appreciation ” located at the top of the main entrance,
          just outside the office. The path has two wood arbors at the points of entry, a bench for
          seating, and beautiful landscaping for students and families to enjoy. The benches will be
          placed outside of the classrooms for outdoor education. This will ensure that we receive
          the paver/bench by or before the end of the school year. Order your paver by March 26,
          2026 and leave your lasting footprint at MBMA! This will ensure that we receive the
          paver/bench by or before the end of the school year.
        </p>
      </div>
    </div>
  </main>
  <script
    is:inline
    src="https://zeffy-scripts.s3.ca-central-1.amazonaws.com/embed-form-script.min.js"></script>
  <script is:inline>
    document.addEventListener(
      'click',
      function (event) {
        var trigger = event.target.closest('a[zeffy-form-link]');
        if (!trigger) return;
        if (document.querySelector('iframe[title="Form powered and secured by Zeffy"]')) {
          event.preventDefault();
        }
      },
      true
    );
  </script>
</Base>

<style>
  .product-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 0.85rem 0 0;
  }
</style>
