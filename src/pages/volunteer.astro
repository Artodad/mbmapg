---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { Content } from '../content/volunteer.md';
import { asset, withBase } from '../lib/site';

const signup =
  'https://www.signupgenius.com/go/10C094CABAB2AA7FDC25-64417788-volunteer';
const chPdf = asset('files/ch-classroom-volunteer.pdf');
const elemPdf = asset('files/elementary-classroom-volunteer.pdf');
---

<Base title="Volunteer" description="Ways to get involved with MBMA Parents Group.">
  <PageHero title="VOLUNTEER" />
  <main>
    <div class="wrap prose">
      <Content />
      <p>
        <a class="btn btn-gold" href={signup}>Sign up on SignUpGenius</a>
      </p>
      <p>
        <a href={chPdf}>CH Classroom Volunteer Descriptions</a><br />
        <a href={elemPdf}>Elementary Classroom Volunteer Descriptions</a>
      </p>
      <p>
        PDFs say contact <a href="mailto:parentsgroup@mbmapg.org">parentsgroup@mbmapg.org</a>
      </p>
      <p>
        <a href={withBase('contact')}>Questions? Contact the board</a>
      </p>
    </div>
  </main>
</Base>
