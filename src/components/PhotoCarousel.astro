---
import { asset } from '../lib/site';
import type { GalleryItem } from '../lib/gallery';

interface Props {
  items: GalleryItem[];
  label?: string;
}

const { items, label = 'Photo gallery' } = Astro.props;
const total = items.length;
---

{
  total > 0 ? (
    <div
      class="carousel"
      data-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label={label}
      tabindex="0"
    >
      <div class="carousel-stage">
        {items.map((item, index) => (
          <figure class="carousel-slide" data-slide hidden={index !== 0}>
            <img src={asset(item.src)} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} />
            {item.caption ? <figcaption>{item.caption}</figcaption> : null}
          </figure>
        ))}
      </div>

      {
        total > 1 ? (
          <div class="carousel-toolbar">
            <button type="button" class="carousel-nav" data-carousel-prev aria-label="Previous photo">
              Previous
            </button>
            <p class="carousel-status" data-carousel-status aria-live="polite">
              1 / {total}
            </p>
            <button type="button" class="carousel-nav" data-carousel-next aria-label="Next photo">
              Next
            </button>
          </div>
        ) : null
      }

      {
        total > 1 ? (
          <div class="carousel-dots" role="group" aria-label="Choose a photo">
            {items.map((item, index) => (
              <button
                type="button"
                class="carousel-dot"
                data-carousel-dot
                aria-label={`Show photo ${index + 1}${item.caption ? `: ${item.caption}` : ''}`}
                aria-current={index === 0 ? 'true' : undefined}
              />
            ))}
          </div>
        ) : null
      }
    </div>
  ) : null
}

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-carousel]');

  roots.forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const prev = root.querySelector('[data-carousel-prev]');
    const next = root.querySelector('[data-carousel-next]');
    const status = root.querySelector('[data-carousel-status]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const total = slides.length;
    if (total < 2) return;

    let index = slides.findIndex((slide) => !slide.hidden);
    if (index < 0) index = 0;

    const show = (nextIndex: number) => {
      index = ((nextIndex % total) + total) % total;
      slides.forEach((slide, i) => {
        slide.hidden = i !== index;
      });
      if (status) {
        status.textContent = `${index + 1} / ${total}`;
      }
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    };

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => show(i));
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
    });

    let startX = 0;
    let startY = 0;
    root.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.changedTouches[0];
        if (!touch) return;
        startX = touch.clientX;
        startY = touch.clientY;
      },
      { passive: true },
    );
    root.addEventListener(
      'touchend',
      (event) => {
        const touch = event.changedTouches[0];
        if (!touch) return;
        const dx = touch.clientX - startX;
        const dy = touch.clientY - startY;
        if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy)) return;
        show(dx < 0 ? index + 1 : index - 1);
      },
      { passive: true },
    );
  });
</script>
