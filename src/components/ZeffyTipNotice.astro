---
import { contactEmail } from '../lib/site';
---

<div class="shop-notice" role="note">
  <p class="shop-notice-title">Set Zeffy’s tip to $0</p>
  <p>
    At checkout, Zeffy may ask for an optional tip. Set that to <strong>$0</strong>. It goes
    to Zeffy, not to MBMA or the parents group.
  </p>
  <p class="shop-notice-contact">
    Questions? Email the board at{' '}
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
  </p>
</div>

<style>
  .shop-notice {
    background: color-mix(in srgb, var(--peach) 42%, var(--white));
    border: 1px solid color-mix(in srgb, var(--peach) 58%, var(--rule));
    border-top: 3px solid var(--peach);
    border-radius: var(--radius);
    padding: 1rem 1.15rem 0.95rem;
    margin: 0 0 1.35rem;
  }

  .shop-notice-title {
    font-family: var(--heading);
    font-weight: 700;
    font-size: 1.08rem;
    margin: 0 0 0.3rem;
  }

  .shop-notice p {
    margin: 0;
  }

  .shop-notice-title + p {
    margin-top: 0.15rem;
  }

  .shop-notice-contact {
    margin-top: 0.75rem;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in srgb, var(--peach) 55%, var(--rule));
    color: var(--ink-muted);
    font-size: 0.95rem;
  }
</style>
