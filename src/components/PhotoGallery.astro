---
import { asset } from '../lib/site';
import type { GalleryItem } from '../lib/gallery';

interface Props {
  items: GalleryItem[];
  label?: string;
  pageSize?: number;
}

const { items, label = 'School photo gallery', pageSize = 4 } = Astro.props;
const total = items.length;
const firstEnd = Math.min(pageSize, total);
const statusText = total > 0 ? `${1}–${firstEnd} of ${total}` : '';
---

{
  total > 0 ? (
    <div
      class="photo-gallery"
      data-photo-gallery
      data-page-size={String(pageSize)}
      role="region"
      aria-label={label}
      tabindex="0"
    >
      <div class="gallery gallery-home" data-gallery-grid>
        {items.map((item, index) => {
          const title = item.caption || item.alt;
          return (
            <figure
              class="gallery-item"
              data-gallery-item
              data-index={String(index)}
              hidden={index >= pageSize}
            >
              <button
                type="button"
                class="gallery-open"
                data-lightbox-open
                data-index={String(index)}
                aria-label={`View larger: ${title}`}
              >
                <img
                  src={asset(item.src)}
                  alt={item.alt}
                  loading={index < pageSize ? 'eager' : 'lazy'}
                />
              </button>
              {item.caption ? <figcaption>{item.caption}</figcaption> : null}
            </figure>
          );
        })}
      </div>

      {total > pageSize ? (
        <div class="gallery-toolbar">
          <button type="button" class="gallery-nav" data-gallery-prev aria-label="Previous photos">
            Previous
          </button>
          <p class="gallery-status" data-gallery-status aria-live="polite">
            {statusText}
          </p>
          <button type="button" class="gallery-nav" data-gallery-next aria-label="Next photos">
            Next
          </button>
        </div>
      ) : null}

      <div
        class="lightbox"
        data-lightbox
        hidden
        role="dialog"
        aria-modal="true"
        aria-label="Enlarged photo"
      >
        <div class="lightbox-backdrop" data-lightbox-dismiss></div>
        <div class="lightbox-panel">
          <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close photo">
            <span aria-hidden="true">×</span>
            <span class="visually-hidden">Close</span>
          </button>
          {total > 1 ? (
            <button
              type="button"
              class="lightbox-nav lightbox-prev"
              data-lightbox-prev
              aria-label="Previous photo"
            >
              Previous
            </button>
          ) : null}
          <figure class="lightbox-figure">
            <img data-lightbox-image src={asset(items[0].src)} alt={items[0].alt} />
            <figcaption data-lightbox-caption>{items[0].caption || items[0].alt}</figcaption>
          </figure>
          {total > 1 ? (
            <button
              type="button"
              class="lightbox-nav lightbox-next"
              data-lightbox-next
              aria-label="Next photo"
            >
              Next
            </button>
          ) : null}
        </div>
      </div>
    </div>
  ) : null
}

<script>
  const PAGE_SIZE_DEFAULT = 4;

  const roots = document.querySelectorAll<HTMLElement>('[data-photo-gallery]');

  roots.forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-gallery-item]'));
    const total = items.length;
    if (!total) return;

    const pageSize = Number(root.dataset.pageSize) || PAGE_SIZE_DEFAULT;
    const pageCount = Math.max(1, Math.ceil(total / pageSize));
    const prev = root.querySelector('[data-gallery-prev]');
    const next = root.querySelector('[data-gallery-next]');
    const status = root.querySelector('[data-gallery-status]');
    const lightbox = root.querySelector<HTMLElement>('[data-lightbox]');
    const lightboxImage = root.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const lightboxCaption = root.querySelector('[data-lightbox-caption]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const lightboxPrev = root.querySelector('[data-lightbox-prev]');
    const lightboxNext = root.querySelector('[data-lightbox-next]');
    const openers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));

    const photos = items.map((item, index) => {
      const img = item.querySelector('img');
      const caption = item.querySelector('figcaption');
      return {
        src: img?.currentSrc || img?.src || '',
        alt: img?.alt || '',
        caption: caption?.textContent?.trim() || img?.alt || '',
        opener: openers[index] ?? null,
      };
    });

    let page = 0;
    let lightboxIndex = 0;
    let lastOpener: HTMLElement | null = null;

    const pageRange = (pageIndex: number) => {
      const start = pageIndex * pageSize + 1;
      const end = Math.min(total, (pageIndex + 1) * pageSize);
      return { start, end };
    };

    const showPage = (nextPage: number) => {
      page = ((nextPage % pageCount) + pageCount) % pageCount;
      const start = page * pageSize;
      const end = start + pageSize;
      items.forEach((item, index) => {
        item.hidden = index < start || index >= end;
      });
      if (status) {
        const range = pageRange(page);
        status.textContent = `${range.start}–${range.end} of ${total}`;
      }
    };

    const focusable = () => {
      if (!lightbox) return [];
      return Array.from(
        lightbox.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.hasAttribute('hidden') && el.offsetParent !== null);
    };

    const setLightboxPhoto = (index: number) => {
      lightboxIndex = ((index % total) + total) % total;
      const photo = photos[lightboxIndex];
      if (!photo || !lightboxImage) return;
      lightboxImage.src = photo.src;
      lightboxImage.alt = photo.alt;
      if (lightboxCaption) {
        lightboxCaption.textContent = photo.caption;
      }
    };

    const openLightbox = (index: number, opener?: HTMLElement | null) => {
      if (!lightbox) return;
      lastOpener = opener ?? photos[index]?.opener ?? null;
      setLightboxPhoto(index);
      lightbox.hidden = false;
      document.body.classList.add('lightbox-locked');
      closeBtn?.focus();
    };

    const closeLightbox = () => {
      if (!lightbox || lightbox.hidden) return;
      lightbox.hidden = true;
      document.body.classList.remove('lightbox-locked');
      lastOpener?.focus();
    };

    const isOpen = () => Boolean(lightbox && !lightbox.hidden);

    prev?.addEventListener('click', () => showPage(page - 1));
    next?.addEventListener('click', () => showPage(page + 1));

    openers.forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.index);
        if (Number.isNaN(index)) return;
        openLightbox(index, button);
      });
    });

    closeBtn?.addEventListener('click', () => closeLightbox());
    root.querySelector('[data-lightbox-dismiss]')?.addEventListener('click', () => closeLightbox());
    lightboxPrev?.addEventListener('click', () => setLightboxPhoto(lightboxIndex - 1));
    lightboxNext?.addEventListener('click', () => setLightboxPhoto(lightboxIndex + 1));

    root.addEventListener('keydown', (event) => {
      if (isOpen()) {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeLightbox();
          return;
        }
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          setLightboxPhoto(lightboxIndex - 1);
          return;
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          setLightboxPhoto(lightboxIndex + 1);
          return;
        }
        if (event.key === 'Tab' && lightbox) {
          const nodes = focusable();
          if (!nodes.length) return;
          const first = nodes[0];
          const last = nodes[nodes.length - 1];
          const active = document.activeElement;
          if (event.shiftKey && active === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && active === last) {
            event.preventDefault();
            first.focus();
          } else if (active && !lightbox.contains(active)) {
            event.preventDefault();
            first.focus();
          }
        }
        return;
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showPage(page - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        showPage(page + 1);
      }
    });

    let startX = 0;
    let startY = 0;
    const stage = root.querySelector<HTMLElement>('[data-gallery-grid]');
    stage?.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.changedTouches[0];
        if (!touch) return;
        startX = touch.clientX;
        startY = touch.clientY;
      },
      { passive: true },
    );
    stage?.addEventListener(
      'touchend',
      (event) => {
        if (isOpen()) return;
        const touch = event.changedTouches[0];
        if (!touch) return;
        const dx = touch.clientX - startX;
        const dy = touch.clientY - startY;
        if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy)) return;
        showPage(dx < 0 ? page + 1 : page - 1);
      },
      { passive: true },
    );
  });
</script>
