---
import { navItems, siteName, withBase, wixDonateUrl } from '../lib/site';

const current = Astro.url.pathname.replace(/\/$/, '') || withBase('').replace(/\/$/, '');
const homePath = withBase('home').replace(/\/$/, '');
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase('home')}>
      <span class="brand-text">{siteName}</span>
    </a>
    <div class="header-tools">
      <nav class="nav" id="site-nav" aria-label="Primary">
        {
          navItems.map((item) => {
            const external = item.href.startsWith('http');
            const href = external ? item.href : withBase(item.href);
            const normalized = href.replace(/\/$/, '');
            const isCurrent =
              !external &&
              (current === normalized ||
                (item.href === 'home' && (current === homePath || current.endsWith('/v2'))));
            return (
              <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                {item.label}
              </a>
            );
          })
        }
      </nav>
      <a class="donate-btn" href={wixDonateUrl}>Donate</a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        Menu
      </button>
    </div>
  </div>
  <div class="nav-backdrop" hidden></div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('#site-nav');
  const backdrop = document.querySelector('.nav-backdrop');

  const setOpen = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    backdrop?.classList.toggle('is-open', open);
    if (backdrop instanceof HTMLElement) {
      backdrop.hidden = !open;
    }
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.classList.toggle('nav-locked', open);
  };

  toggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
  });

  backdrop?.addEventListener('click', () => setOpen(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 1041px)').matches) {
      setOpen(false);
    }
  });
</script>
