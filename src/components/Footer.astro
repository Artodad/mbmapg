---
import { calendarPdf, calendarPdfLabel, contactEmail, withBase } from '../lib/site';
import SeasonalArt from './SeasonalArt.astro';
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-name">Mission Bay Montessori Academy Parents Group Foundation</p>
      <p class="footer-meta">
        ©2026 · <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </p>
      <p class="footer-season">
        <SeasonalArt kind="pumpkin" class="footer-season-mark" />
        Happy October from the Parents Group
      </p>
    </div>
    <p class="footer-links">
      <a href={calendarPdf}>{calendarPdfLabel}</a>
      <a href={withBase('give')}>Donate</a>
      <a href={withBase('contact')}>Contact</a>
    </p>
  </div>
</footer>
